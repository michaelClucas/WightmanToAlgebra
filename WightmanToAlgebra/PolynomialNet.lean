import WightmanToAlgebra.HaagKastler

/-! The polynomial field net of a Wightman theory.

`P(O)` is the unital subalgebra of `End(D)` (D = common Wightman domain)
generated by smeared fields `φ(l, f)` with `tsupport f ⊆ O`. The *-operation is
the formal adjoint on `D`: `X⋆` is the unique `Y` with `⟨X u, v⟩ = ⟨u, Y v⟩` for
all `u v ∈ D`. Uniqueness uses density of `D`; existence inside `P(O)` uses the
upstream adjoint axiom `φ(l, f)⋆ = φ(adjointLabel l, conj f)`, since
`conj f` has the same support as `f`. -/

set_option autoImplicit false
noncomputable section

namespace WightmanToAlgebra

open YangMills

variable {H : HilbertSpace} {Labels : FieldLabels}

/-- Smeared fields with test-function support in `A`, as endomorphisms of the domain. -/
def localGenerators (F : FieldSystem H Labels) (A : Set Spacetime) :
    Set (Module.End ℂ F.domain) :=
  {X | ∃ (l : Labels.carrier) (f : TestFunction), tsupport (f : Spacetime → ℂ) ⊆ A ∧
    X = F.field l f}

theorem localGenerators_mono (F : FieldSystem H Labels) {A B : Set Spacetime}
    (h : A ⊆ B) : localGenerators F A ⊆ localGenerators F B := by
  rintro X ⟨l, f, hf, rfl⟩
  exact ⟨l, f, hf.trans h, rfl⟩

/-- The polynomial algebra of fields localised in `A`. -/
def polynomialAlgebra (F : FieldSystem H Labels) (A : Set Spacetime) :
    Subalgebra ℂ (Module.End ℂ F.domain) :=
  Algebra.adjoin ℂ (localGenerators F A)

theorem polynomialAlgebra_mono (F : FieldSystem H Labels) {A B : Set Spacetime}
    (h : A ⊆ B) : polynomialAlgebra F A ≤ polynomialAlgebra F B :=
  Algebra.adjoin_mono (localGenerators_mono F h)

/-- `Y` is a formal adjoint of `X` on the domain. -/
def IsFormalAdjoint (F : FieldSystem H Labels) (X Y : Module.End ℂ F.domain) : Prop :=
  ∀ u v : F.domain, inner ℂ (X u).1 v.1 = inner ℂ u.1 (Y v).1

theorem formalAdjoint_unique (F : FieldSystem H Labels) (hF : F.DomainAxioms)
    {X Y Y' : Module.End ℂ F.domain} (hY : IsFormalAdjoint F X Y)
    (hY' : IsFormalAdjoint F X Y') : Y = Y' := by
  sorry

theorem exists_formalAdjoint (T : WightmanTheory H Labels) (hT : T.Axioms)
    (A : Set Spacetime) {X : Module.End ℂ T.fields.domain}
    (hX : X ∈ polynomialAlgebra T.fields A) :
    ∃ Y ∈ polynomialAlgebra T.fields A, IsFormalAdjoint T.fields X Y := by
  sorry

section Star

variable (T : WightmanTheory H Labels) (hT : T.Axioms) (A : Set Spacetime)

@[reducible] def polyStar : Star (polynomialAlgebra T.fields A) where
  star X := ⟨(exists_formalAdjoint T hT A X.2).choose,
    (exists_formalAdjoint T hT A X.2).choose_spec.1⟩

@[reducible] def polyStarRing : StarRing (polynomialAlgebra T.fields A) :=
  { polyStar T hT A with
    star_involutive := sorry
    star_mul := sorry
    star_add := sorry }

theorem polyStarModule :
    letI := polyStarRing T hT A
    StarModule ℂ (polynomialAlgebra T.fields A) :=
  letI := polyStarRing T hT A
  ⟨sorry⟩

end Star

/-- The polynomial field net `O ↦ P(O)`. -/
def polynomialNet (T : WightmanTheory H Labels) (hT : T.Axioms) : Net where
  Alg O := polynomialAlgebra T.fields O.carrier
  ring _ := inferInstance
  algebra _ := inferInstance
  starRing O := polyStarRing T hT O.carrier
  starModule O := polyStarModule T hT O.carrier
  incl {O₁ O₂} h :=
    letI := polyStarRing T hT O₁.carrier
    letI := polyStarRing T hT O₂.carrier
    { Subalgebra.inclusion (polynomialAlgebra_mono T.fields h) with
      map_star' := sorry }

/-- `P(O) → P(gO)`, `X ↦ U(g) X U(g)⁻¹` restricted to the invariant domain. -/
def polynomialCovariance (T : WightmanTheory H Labels) (hT : T.Axioms) :
    (polynomialNet T hT).Covariance :=
  sorry

end WightmanToAlgebra
